# URL of the signaling server.
# Leave empty or unset to default to <current-protocol>//<current-hostname>:3001
# (useful for local LAN dev). Set explicitly for production (e.g. your Render URL).
# VITE_SERVER_URL=https://your-server.onrender.com
VITE_SERVER_URL=

# Optional TURN relay. Only needed on unusual networks where direct P2P fails
# (AP isolation, strict NAT). Leave empty for normal same-LAN usage.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
