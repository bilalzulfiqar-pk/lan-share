# Optional: Canonical site URL override (defaults to the deployed production URL if omitted)
# VITE_SITE_URL=https://your-site.example.com

# URL of the signaling backend server.
# Leave empty or unset to default to <current-protocol>//<current-hostname>:3001
# (useful for local LAN dev). Set explicitly for your production backend server.
# VITE_SERVER_URL=https://your-backend-server.example.com
VITE_SERVER_URL=

# Optional TURN relay (only needed on unusual networks with AP isolation or strict NAT).
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
